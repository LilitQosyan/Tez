#include <iostream>
#include <vector>
#include <string>
#include <iomanip>
#include <cmath>

using namespace std;

struct Boundary {
    double min, max;
};

int main() {
    int KET, N, M1;
    double target_weight;

    cout << "=== NUTELLA OPTIMIZER: QUALITY CHECK (Q < 1) ===" << endl;
    
    cout << "Քանի փուլով է իրականացվոում օպտիմալացումը ; cin >> KET;
    cout << "Մուտքային փոփոխականների քանակը ամեն փուլում: "; cin >> N;
    cout << "Կառավարող փոփոխականների  քանակը ամեն փուլում: "; cin >> M1;
    cout << "Թիրախային քաշ (գրամ): "; cin >> target_weight;

    vector<vector<Boundary>> X_bounds(KET, vector<Boundary>(N));
    vector<vector<Boundary>> U_bounds(KET, vector<Boundary>(M1));

    for (int i = 0; i < KET; i++) {
        cout << "\n--- ՓՈՒԼ " << i + 1 << " ---" << endl;
        for (int j = 0; j < N; j++) {
            cout << "  X" << i << j+1 << " [MIN MAX]: "; cin >> X_bounds[i][j].min >> X_bounds[i][j].max;
        }
        for (int j = 0; j < M1; j++) {
            cout << "  U" << i+1 << j+1 << " [MIN MAX]: "; cin >> U_bounds[i][j].min >> U_bounds[i][j].max;
        }
    }

    double total_Q = 0;
    double current_sum = 0;
    
    // Հաշվարկում ենք քաշի բաշխման գործակիցը
    double total_max = 0;
    for(int i=0; i<KET; i++) for(int j=0; j<N; j++) total_max += X_bounds[i][j].max;
    double factor = target_weight / total_max;

    cout << "\n" << string(70, '=') << endl;
    cout << left << setw(10) << "Փուլ" << setw(30) << "Քանակներ (X)" << "Stage Q" << endl;
    cout << string(70, '-') << endl;
    cout << fixed << setprecision(3);

    for (int i = 0; i < KET; i++) {
        double stage_q = 0;
        string x_vals = "";
        for (int j = 0; j < N; j++) {
            double opt_x = X_bounds[i][j].max * factor;
            current_sum += opt_x;
            x_vals += to_string((int)opt_x) + "գ. ";
            
            // Q_stage = (Շեղում առավելագույնից)^2
            stage_q += pow(X_bounds[i][j].max - opt_x, 2);
        }
        cout << left << setw(10) << i + 1 << setw(30) << x_vals << stage_q << endl;
        total_Q += stage_q;
    }

    // Նորմավորում ենք Q-ն, որպեսզի այն լինի հասկանալի տիրույթում
    double normalized_Q = total_Q / 100.0; 

    cout << string(70, '=') << endl;
    cout << "Ընդհանուր քաշ: " << current_sum << " գրամ" << endl;
    cout << "Օպտիմալության չափանիշ (Q): " << normalized_Q << endl;

    // --- ԵՐԿՐՈՐԴ ՊԱՅՄԱՆԻ ՍՏՈՒԳՈՒՄ ---
    cout << "\nՍտուգվում է որակի պայմանը (Q < 1)..." << endl;
    
    if (normalized_Q < 1.0) {
        cout << ">>> ՀԱՋՈՂՈՒԹՅՈՒՆ! Q = " << normalized_Q << " (փոքր է 1-ից):" << endl;
        cout << "Արտադրանքը համապատասխանում է բարձր որակի չափանիշներին:" << endl;
    } else {
        cout << ">>> ՈՒՇԱԴՐՈՒԹՅՈՒՆ! Q = " << normalized_Q << " (մեծ է 1-ից):" << endl;
        cout << "Որակը բավարար չէ: Խորհուրդ է տրվում վերանայել սահմանները:" << endl;
    }

    return 0;
}
