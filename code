using namespace std;

struct Component {
    string name;
    double min, max, W, optimal_val;
};

int main() {
    const double X1 = 100.0; 
    
    vector<Component> recipe = {
        {"Շաքար", 52, 58, 0.25, 0},        
        {"Բուսայուղ", 14, 22, 0.20, 0},    
        {"Ընկույզ", 10, 15, 0.18, 0},     
        {"Կակաո", 5, 9, 0.17, 0},         
        {"Կաթի փոշի", 4, 8, 0.15, 0},       
        {"Հավելումներ", 0, 2, 0.05, 0}      
    };

    double current_scalar = 0; // Ընթացիկ խտացված արժեքը
    double total_weighted_space = 0; // Կշռված ազատ տարածությունը բաշխման համար
    
    for (int i = 0; i < recipe.size(); i++) {
        recipe[i].optimal_val = recipe[i].min;
        current_scalar += recipe[i].optimal_val;
        total_weighted_space += (recipe[i].max - recipe[i].min) * recipe[i].weight;
    }

    double needed = TARGET_SCALAR - current_scalar;

    if (needed > 0) {
        for (int i = 0; i < recipe.size(); i++) {
            double space = recipe[i].max - recipe[i].min;
            double proportion = (space * recipe[i].weight) / total_weighted_space;
            double to_add = min(space, needed * proportion); 
            recipe[i].optimal_val += to_add;
        }
    }

    // ՏՊՈՒՄ
    cout << fixed << setprecision(1);
    cout << "=== ՆՈՒՏԵԼԼԱՅԻ ՕՊՏԻՄԱԼ ԲԱՂԱԴՐԱՏՈՄՍ (y1 = 100) ===\n" << endl;
    
    cout << left << setw(16) << "Բաղադրիչ" << "\tMin\tMax\tԱլգորիթմ\tԻրական" << endl;
    cout << "----------------------------------------------------------------" << endl;
    
    double final_weight = 0;
    vector<double> real_vals = {54.0, 18.5, 13.0, 7.4, 6.6, 0.5};
    
    for (int i = 0; i < recipe.size(); i++) {
        cout << left << setw(16) << recipe[i].name 
             << "\t" << recipe[i].min << "\t" << recipe[i].max << "\t" 
             << recipe[i].optimal_val << "\t\t" << real_vals[i] << endl;
        final_weight += recipe[i].optimal_val;
    }
    
    cout << "\nՍտացված խտացված արժեքը (y1): " << final_weight << " գրամ" << endl;

    return 0;
}
